# ==============================================================
# MLIC CHALLENGE - Production Environment Configuration
# ==============================================================

# Server Host & Port
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# PostgreSQL Database Connection URL
# Set your PostgreSQL connection string here:
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql://postgres:mypassword@localhost:5432/mlic_challenge
DATABASE_URL=postgres://username:password@hostname:5432/dbname

# Secret key for session authentication tokens
JWT_SECRET=mlic-challenge-production-secret-2026
